<navbar title="{{pick ? '选择车辆' : '我的爱车'}}" />
<view class="main">
  <async-view state="{{state}}" error="{{error}}" rows="2" bind:retry="onRetry" emptyIcon="car" emptyTitle="还没有登记车辆" emptyText="添加车牌后即可预约服务。">
    <view class="col gap12">
      <view wx:for="{{cars}}" wx:key="id" class="card col" style="overflow:hidden;" hover-class="{{pick ? 'hover' : ''}}" data-id="{{item.id}}" bindtap="choose">
        <view class="rel center" style="height:96px;background:linear-gradient(135deg,#F4F7FB,#E6ECF4);"><image src="/images/car-grey.svg" style="width:140px;height:52px;" aria-hidden="true" /><view wx:if="{{item.isDefault}}" style="position:absolute;right:14px;top:12px;"><text class="pill blue">默认</text></view></view>
        <view class="col" style="padding:14px 16px 16px;gap:10px;">
          <view class="row" style="gap:12px;"><plate plate="{{item.plate}}" energy="{{item.energy}}" /><text class="t14 w5 one">{{item.title}}</text></view>
          <view class="row" style="gap:8px;flex-wrap:wrap;">
            <text wx:if="{{item.ev}}" class="t11 c-sub" style="background:#F4F4F5;border-radius:9px;padding:2px 10px;">新能源</text>
            <text class="t11 c-sub" style="background:#F4F4F5;border-radius:9px;padding:2px 10px;">累计到店 {{item.visits}} 次</text>
          </view>
        </view>
      </view>
    </view>
  </async-view>
  <view class="card-22 center gap6" style="height:54px;border:1px dashed #D4D4D8;box-shadow:none;background:transparent;border-radius:20px;" hover-class="hover" bindtap="add" role="button"><icon name="plus" size="18" color="#52525B" stroke="2" /><text class="t14 w5 c-sub">添加车辆</text></view>
</view>
