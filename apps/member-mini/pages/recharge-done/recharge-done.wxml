<!-- 由 tools/px2rpx.py 从 recharge-done.px.wxml 生成，请改源文件，不要直接编辑本文件。 -->
<navbar title="充值成功" bind:back="home" />
<view class="main main-bar">
  <async-view state="{{state}}" error="{{error}}" rows="3" bind:retry="onRetry">
    <view class="done-wrap">
      <view class="rel center" style="width:184.62rpx;height:184.62rpx;"><image class="done-rings" src="/images/done-rings.svg" aria-hidden="true" /><view class="done-mark"><icon name="check" size="44" stroke="2.6" color="#FFFFFF" /></view></view>
      <text style="font-size:42.31rpx;line-height:57.69rpx;font-weight:600;">充值成功</text>
      <text style="font-size:61.54rpx;line-height:76.92rpx;font-weight:600;color:#2B7745;">{{r.total}}</text>
      <text class="t13 c-mute">已到账，可立即使用</text>
    </view>
    <view class="card col">
      <view class="col" style="padding:30.77rpx 0 7.69rpx;">
        <view class="row" style="padding:0 30.77rpx 7.69rpx;gap:19.23rpx;"><text class="t15 w6 grow">充值明细</text><text class="pill green">已到账</text></view>
        <view class="kv"><text class="k">充值金额</text><text class="v">{{r.amount}}</text></view>
        <view wx:if="{{r.gift}}" class="kv"><text class="k">赠送金额</text><text class="v c-green">{{r.gift}}</text></view>
        <view class="kv"><text class="k">支付方式</text><text class="v">{{r.pay}}</text></view>
      </view>
      <view class="dash"><view class="l"></view><view class="r"></view></view>
      <view class="col" style="padding:7.69rpx 0 15.38rpx;">
        <view class="kv"><text class="k">当前余额</text><text class="v c-green">{{r.balance}}</text></view>
        <view class="kv"><text class="k">交易时间</text><text class="v">{{r.at}}</text></view>
        <view class="kv"><text class="k">交易单号</text><text class="v">{{r.no}}</text></view>
      </view>
    </view>
  </async-view>
</view>
<view class="bar">
  <view class="btn btn-soft" hover-class="hover" bindtap="records">查看记录</view>
  <view class="btn btn-dark" hover-class="hover" bindtap="home">返回首页</view>
</view>
