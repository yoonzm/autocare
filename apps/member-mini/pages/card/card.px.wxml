<navbar title="会员权益" />
<view class="main">
  <async-view state="{{state}}" error="{{error}}" skeleton="hero" bind:retry="onRetry" emptyIcon="crown" emptyTitle="您还不是该门店会员">
    <view class="hero" style="gap:14px;">
      <image class="hero-rings" src="/images/rings.svg" aria-hidden="true" />
      <view class="row"><text class="pill gold-ink">{{m.level}}</text><view class="grow"></view><text class="t12" style="color:#A1A1AA;">{{m.joined}}</text></view>
      <view class="col gap4"><text style="font-size:24px;line-height:32px;font-weight:600;color:#FAFAFA;">{{m.name}}</text><text class="t13" style="color:#A1A1AA;">{{m.phone}}</text></view>
      <view class="col gap8">
        <view style="height:6px;border-radius:3px;background:rgba(255,255,255,.12);overflow:hidden;"><view style="height:6px;border-radius:3px;background:#F5D78E;width:{{progress}}%;"></view></view>
        <text class="t12" style="color:#F5D78E;">{{hint}}</text>
      </view>
    </view>

    <view class="sec-box">
      <text class="sec">会员等级</text>
      <view class="card" style="padding:18px 8px 16px;display:flex;position:relative;">
        <view wx:for="{{steps}}" wx:key="id" class="col" style="flex:1 1 0;align-items:center;gap:6px;position:relative;">
          <view class="center" style="width:24px;height:24px;border-radius:12px;background:{{item.state === 'done' ? '#17C964' : item.state === 'current' ? '#F5D78E' : '#E4E4E7'}};color:{{item.state === 'done' ? '#FFFFFF' : '#18181B'}};"><icon wx:if="{{item.state !== 'todo'}}" name="check" size="14" stroke="3" color="{{item.state === 'done' ? '#FFFFFF' : '#18181B'}}" /></view>
          <text class="t13 w6">{{item.name}}</text>
          <text class="t11 c-mute tc">{{item.need}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{benefits.length}}" class="sec-box">
      <text class="sec">{{levelName}}专属权益</text>
      <view style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;">
        <view wx:for="{{benefits}}" wx:key="title" class="col" style="border-radius:22px;padding:14px;gap:10px;background:{{item.bg}};">
          <view class="center" style="width:36px;height:36px;border-radius:12px;background:rgba(255,255,255,.7);"><icon name="{{item.icon}}" size="18" color="#18181B" /></view>
          <view class="col gap2"><text class="t14 w6">{{item.title}}</text><text class="t12 c-sub">{{item.desc}}</text></view>
        </view>
      </view>
    </view>

    <view class="sec-box">
      <text class="sec">积分</text>
      <view class="list" style="padding:4px 0;">
        <view class="kv"><text class="k">当前积分</text><text class="v" style="font-size:18px;">{{m.points}}</text></view>
        <view class="line"></view>
        <view class="kv" hover-class="hover" bindtap="points"><text class="k">积分明细</text><view class="grow"></view><icon name="chevron" size="16" color="#A1A1AA" stroke="2" /></view>
      </view>
    </view>
  </async-view>
</view>
