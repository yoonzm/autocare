# Imported inside autocare.mymember.ltd, before the API/admin handlers.
handle /legal/* {
    @legalFiles {
        method GET HEAD
        path /legal/privacy.html /legal/terms.html
    }
    handle @legalFiles {
        root * /srv/autocare
        header {
            Cache-Control "public, max-age=300"
            X-Content-Type-Options nosniff
            Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"
        }
        file_server
    }
    handle {
        respond "Not found" 404
    }
}
